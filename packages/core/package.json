{
  "name": "@konfetti-js/core",
  "version": "0.2.0",
  "description": "A lightweight, performant confetti animation library for the web",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/konfetti.min.js",
  "jsdelivr": "./dist/konfetti.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format src --write",
    "check": "biome check src --write"
  },
  "keywords": [
    "confetti",
    "konfetti",
    "particles",
    "animation",
    "canvas",
    "celebration"
  ],
  "author": "Andrea Bettich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreabettich/konfetti.js.git",
    "directory": "packages/core"
  },
  "homepage": "https://andreabettich.github.io/konfetti.js/",
  "bugs": {
    "url": "https://github.com/andreabettich/konfetti.js/issues"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
