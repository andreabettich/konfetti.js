{
  "name": "@konfetti-js/react",
  "version": "0.4.0",
  "description": "React wrapper for konfetti.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "check": "biome check src --write"
  },
  "keywords": [
    "konfetti",
    "confetti",
    "react",
    "animation"
  ],
  "author": "Andrea Bettich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreabettich/konfetti.js.git",
    "directory": "packages/react"
  },
  "homepage": "https://andreabettich.github.io/konfetti.js/",
  "bugs": {
    "url": "https://github.com/andreabettich/konfetti.js/issues"
  },
  "dependencies": {
    "@konfetti-js/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
